{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Copilot",
  "version": "0.1.8",
  "identifier": "com.meetingcopilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Meeting Copilot",
        "width": 1360,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.aliyuncs.com https://dashscope.aliyuncs.com https://asr.cloud.tencent.com wss://asr.cloud.tencent.com; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
      "icon": ["icons/icon.icns"],
    "resources": ["resources/MeetingCaptureBridge", "resources/PdfTextBridge"],
    "category": "Productivity",
    "shortDescription": "A local knowledge-grounded meeting and interview copilot.",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "exceptionDomain": "",
      "frameworks": []
    }
  }
}
